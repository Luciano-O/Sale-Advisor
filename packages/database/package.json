{
  "name": "@sale-advisor/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:rollback:local": "tsx src/rollback-local.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.3",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@sale-advisor/config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3"
  }
}
