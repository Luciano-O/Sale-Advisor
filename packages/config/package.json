{
  "name": "@sale-advisor/config",
  "version": "0.2.0",
  "private": true,
  "description": "Configuracoes compartilhadas de TypeScript, lint, formatting e ambiente.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
