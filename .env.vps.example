# Copy to .env.vps on the VPS (never commit it) and replace every placeholder.
# Generate secrets with: openssl rand -hex 32

# Domains: create DNS A/AAAA records for both pointing to the VPS before the first start.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Loopback ports the host's web server proxies to (see docs/vps-runbook.md).
API_HOST_PORT=3200
ADMIN_HOST_PORT=3201

POSTGRES_DB=sale_advisor
POSTGRES_USER=sale_advisor
POSTGRES_PASSWORD=replace-with-a-random-database-password
REDIS_PASSWORD=replace-with-a-random-redis-password
# Repeat the passwords above inside the URLs.
DATABASE_URL=postgresql://sale_advisor:replace-with-a-random-database-password@postgres:5432/sale_advisor
REDIS_URL=redis://:replace-with-a-random-redis-password@redis:6379
# API and worker open several pools each; 4 keeps the total well below PostgreSQL's 100.
DATABASE_POOL_MAX=4

ADMIN_API_KEY=replace-with-at-least-32-random-characters
# Overridden by compose.vps.yaml; kept because compose.production.yaml requires it.
CORS_ALLOWED_ORIGINS=https://admin.example.com
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

BACKUP_DIR=/var/backups/sale-advisor

NOTIFICATION_PROVIDER=fake
# Enable only after the smoke, with a session created for this VPS (see docs/vps-runbook.md).
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHATS=
TELEGRAM_INITIAL_HISTORY_LIMIT=1000
WORKER_INSTANCE_ID=vps-1

IMAGE_TAG=local
