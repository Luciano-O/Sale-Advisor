{
  "expo": {
    "name": "Sale Advisor",
    "slug": "sale-advisor",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "saleadvisor",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#2147F0"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/barlow/400Regular/Barlow_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/barlow/500Medium/Barlow_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/barlow/600SemiBold/Barlow_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/barlow/700Bold/Barlow_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/barlow-condensed/500Medium/BarlowCondensed_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/barlow-condensed/800ExtraBold/BarlowCondensed_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "android": {
      "package": "com.saleadvisor.mobile",
      "permissions": ["POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#2147F0"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc8bc26f-4913-42b4-934a-cbbda71dd7af"
      }
    },
    "owner": "luck109",
    "backgroundColor": "#F1F2F5",
    "icon": "./assets/brand/icon.png"
  }
}
