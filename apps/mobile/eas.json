{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "personal": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "node": "24.18.0",
      "pnpm": "11.7.0",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.lgpro.hmservers.net" }
    }
  }
}
