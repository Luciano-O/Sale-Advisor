{
  "name": "@sale-advisor/api",
  "version": "0.2.0",
  "private": true,
  "description": "Backend HTTP do Sale Advisor.",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm --filter @sale-advisor/contracts build && corepack pnpm --filter @sale-advisor/database build && tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@sale-advisor/contracts": "workspace:*",
    "@sale-advisor/database": "workspace:*",
    "bullmq": "^5.58.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@sale-advisor/config": "workspace:*",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3"
  }
}
