{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "node /app/migrate/dist/migrate.js",
    "startCommand": "node /app/api/dist/main.js",
    "healthcheckPath": "/v1/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 10,
    "drainingSeconds": 30,
    "multiRegionConfig": {
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    }
  }
}
